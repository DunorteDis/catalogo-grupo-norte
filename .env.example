# Postgres da empresa (schema crm). O postgres.js lê estas variáveis sozinho.
PGHOST=172.16.0.20
PGPORT=5432
PGDATABASE=dbprod
PGUSER=
PGPASSWORD=

# Assina o cookie de sessão. 32+ caracteres aleatórios; trocar derruba todas as sessões.
SESSION_SECRET=

# Fotos de produto (bucket privado; o app serve por URL assinada). O SDK lê as AWS_* sozinho.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Só se o app for servido por HTTP puro (sem HTTPS) em produção.
# COOKIE_INSEGURO=1

# Só para scripts/copiar-senhas.ts (Supabase → Project Settings → Database).
# SUPABASE_DB_URL=

# WhatsApp pela W-API: o token de cada número fica em crm.whatsapp_numeros. A chave
# protege o webhook (/api/whatsapp?chave=...), que fica aberto à internet.
WAPI_WEBHOOK_CHAVE=
# Endereço público do CRM em HTTPS, para a W-API entregar as mensagens. Sem ele, vale o
# endereço por onde o admin conecta o número em Usuários › WhatsApp.
# APP_URL=https://crm.exemplo.com.br
